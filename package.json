{
  "name": "moss-launcher",
  "version": "0.2.0",
  "description": "苔原 Moss · Minecraft Java Edition Launcher",
  "author": "Moss Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm build",
    "pack": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && node scripts/package-mac.mjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@xmcl/core": "2.16.2",
    "@xmcl/installer": "6.3.6",
    "adm-zip": "^0.5.16",
    "tar": "^7.5.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^0.577.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.25.0",
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "studio.moss.launcher",
    "productName": "Moss Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true
    },
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Moss-Launcher-${version}-${os}-${arch}.${ext}"
  }
}
